{
  "name": "myanmar-link-field",
  "version": "1.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "eas build --platform android --profile development",
    "build:apk": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "build:local": "npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "submit:play": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@reduxjs/toolkit": "^2.0.0",
    "expo": "~51.0.0",
    "expo-camera": "~15.0.0",
    "expo-image-picker": "~15.0.0",
    "expo-location": "~17.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "expo-updates": "~0.25.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "3.31.0",
    "react-redux": "^9.1.0",
    "react-native-webview": "13.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
